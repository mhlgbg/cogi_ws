{
  "kind": "collectionType",
  "collectionName": "structured_node_types",
  "info": {
    "singularName": "structured-node-type",
    "pluralName": "structured-node-types",
    "displayName": "Structured Node Type",
    "description": "Type definitions for nodes within structured trees."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "typeCode": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 1,
      "maxLength": 255
    },
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "required": true
    },
    "allowedParentTypes": {
      "type": "json"
    },
    "metadata": {
      "type": "json"
    },
    "trees": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::structured-tree.structured-tree"
    },
    "nodes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::structured-node.structured-node",
      "mappedBy": "nodeType"
    }
  }
}
