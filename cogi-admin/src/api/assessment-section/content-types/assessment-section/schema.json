{
  "kind": "collectionType",
  "collectionName": "assessment_sections",
  "info": {
    "singularName": "assessment-section",
    "pluralName": "assessment-sections",
    "displayName": "Assessment Section",
    "description": "Logical assessment section grouping questions within a specific assessment version."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "instruction": {
      "type": "richtext"
    },
    "instructionContentType": {
      "type": "enumeration",
      "enum": ["plain_text", "html"],
      "default": "plain_text"
    },
    "instructionImageAsset": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::file-asset.file-asset"
    },
    "stimulus": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::question-stimulus.question-stimulus"
    },
    "questionDisplayMode": {
      "type": "enumeration",
      "enum": ["single", "all", "inline_fill"],
      "default": "single"
    },
    "questionLayoutContent": {
      "type": "richtext"
    },
    "questionLayoutContentType": {
      "type": "enumeration",
      "enum": ["html"],
      "default": "html"
    },
    "audioPlayLimit": {
      "type": "integer"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "skill": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::skill.skill",
      "inversedBy": "assessmentSections"
    },
    "assessmentVersion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::assessment-version.assessment-version",
      "inversedBy": "sections",
      "required": true
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::assessment-question.assessment-question",
      "mappedBy": "section"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "assessmentSections",
      "required": true
    }
  }
}
