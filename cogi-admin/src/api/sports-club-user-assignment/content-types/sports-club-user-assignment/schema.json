{
  "kind": "collectionType",
  "collectionName": "sports_club_user_assignments",
  "info": {
    "singularName": "sports-club-user-assignment",
    "pluralName": "sports-club-user-assignments",
    "displayName": "Sports Club User Assignment",
    "description": "Tenant-scoped assignment of a user to manage a specific sports club."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "sportsClubUserAssignments",
      "required": true
    },
    "club": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sports-club.sports-club",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "required": true,
      "default": "active",
      "index": true
    },
    "assignedAt": {
      "type": "datetime"
    },
    "assignedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "note": {
      "type": "text"
    }
  }
}