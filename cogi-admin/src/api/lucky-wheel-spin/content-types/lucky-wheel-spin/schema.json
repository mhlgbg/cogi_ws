{
  "kind": "collectionType",
  "collectionName": "lucky_wheel_spins",
  "info": {
    "singularName": "lucky-wheel-spin",
    "pluralName": "lucky-wheel-spins",
    "displayName": "Lucky Wheel Spin",
    "description": "Recorded Lucky Wheel spin results"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "requestId": { "type": "string", "required": true, "unique": true },
    "verificationCode": { "type": "string", "required": true, "unique": true },
    "status": { "type": "enumeration", "enum": ["completed","claimed","cancelled"], "default": "completed", "required": true },
    "claimStatus": { "type": "enumeration", "enum": ["not_applicable","unclaimed","claimed"], "default": "unclaimed", "required": true },
    "spunAt": { "type": "datetime", "required": true },
    "claimedAt": { "type": "datetime" },
    "claimedByName": { "type": "string" },
    "claimNote": { "type": "text" },
    "randomValue": { "type": "string" },
    "eligiblePrizesSnapshot": { "type": "json" },
    "participantCodeSnapshot": { "type": "string", "required": true },
    "participantNameSnapshot": { "type": "string" },
    "participantPhoneSnapshot": { "type": "string" },
    "participantEmailSnapshot": { "type": "string" },
    "participantClassNameSnapshot": { "type": "string" },
    "prizeIdSnapshot": { "type": "string" },
    "prizeDocumentIdSnapshot": { "type": "string" },
    "prizeNameSnapshot": { "type": "string", "required": true },
    "prizeDescriptionSnapshot": { "type": "text" },
    "prizeResultMessageSnapshot": { "type": "text" },
    "prizeIsNoPrizeSnapshot": { "type": "boolean", "default": false },
    "prizeDisplayColorSnapshot": { "type": "string" },
    "prizeTextColorSnapshot": { "type": "string" },
    "prizeImageSnapshot": { "type": "json" },
    "ipAddress": { "type": "string" },
    "userAgent": { "type": "text" },
    "isDeleted": { "type": "boolean", "default": false, "required": true },
    "deletedAt": { "type": "datetime" },
    "tenant": { "type": "relation", "relation": "manyToOne", "target": "api::tenant.tenant", "inversedBy": "luckyWheelSpins", "required": true },
    "luckyWheel": { "type": "relation", "relation": "manyToOne", "target": "api::lucky-wheel.lucky-wheel", "inversedBy": "spins", "required": true },
    "participant": { "type": "relation", "relation": "manyToOne", "target": "api::lucky-wheel-participant.lucky-wheel-participant", "inversedBy": "spins", "required": true },
    "prize": { "type": "relation", "relation": "manyToOne", "target": "api::lucky-wheel-prize.lucky-wheel-prize", "inversedBy": "spins" }
  }
}
