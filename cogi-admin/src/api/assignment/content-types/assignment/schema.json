{
  "kind": "collectionType",
  "collectionName": "assignments",
  "info": {
    "singularName": "assignment",
    "pluralName": "assignments",
    "displayName": "Assignment",
    "description": "Class session homework groups with publish and learner progress tracking."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "class": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::class.class",
      "required": true
    },
    "classSession": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::class-session.class-session",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "description": {
      "type": "text"
    },
    "assignedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "assignedAt": {
      "type": "datetime"
    },
    "dueAt": {
      "type": "datetime"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "published", "closed", "cancelled"],
      "default": "draft",
      "required": true
    },
    "note": {
      "type": "text"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "required": true
    },
    "tasks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::assignment-task.assignment-task",
      "mappedBy": "assignment"
    }
  }
}