{
  "kind": "collectionType",
  "collectionName": "event_registrations",
  "info": {
    "singularName": "event-registration",
    "pluralName": "event-registrations",
    "displayName": "Event Registration",
    "description": "Registration record for a tenant event."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "eventRegistrations",
      "required": true
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "registrations",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "registrationCode": {
      "type": "string",
      "required": true,
      "maxLength": 40,
      "unique": true
    },
    "registeredAt": {
      "type": "datetime"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "cancelled", "rejected"],
      "default": "pending",
      "required": true
    },
    "participantCount": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "required": true
    },
    "note": {
      "type": "text"
    },
    "reviewedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "reviewedAt": {
      "type": "datetime"
    },
    "cancelledAt": {
      "type": "datetime"
    },
    "metadata": {
      "type": "json",
      "default": {}
    }
  }
}
