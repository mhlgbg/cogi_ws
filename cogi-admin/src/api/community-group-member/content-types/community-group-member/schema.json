{
  "kind": "collectionType",
  "collectionName": "community_group_members",
  "info": {
    "singularName": "community-group-member",
    "pluralName": "community-group-members",
    "displayName": "CommunityGroupMember",
    "description": "Tenant-scoped membership relation between user and community group."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "communityGroupMembers",
      "required": true
    },
    "group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::community-group.community-group",
      "inversedBy": "members",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "owner",
        "moderator",
        "member"
      ],
      "required": true,
      "default": "member"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "required": true,
      "default": "active"
    },
    "joinedAt": {
      "type": "datetime"
    }
  }
}
