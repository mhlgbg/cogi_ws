{
  "kind": "collectionType",
  "collectionName": "assessment_placement_rules",
  "info": {
    "singularName": "assessment-placement-rule",
    "pluralName": "assessment-placement-rules",
    "displayName": "Assessment Placement Rule",
    "description": "Tenant-scoped configurable placement band rules for one assessment version."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "assessmentVersion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::assessment-version.assessment-version",
      "required": true
    },
    "code": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "ruleType": {
      "type": "enumeration",
      "enum": ["percentage", "raw_score", "custom"],
      "required": true,
      "default": "percentage"
    },
    "scoreBasis": {
      "type": "enumeration",
      "enum": ["objective_only", "scored_total", "final_total"],
      "required": true,
      "default": "objective_only"
    },
    "minPercentage": {
      "type": "decimal"
    },
    "maxPercentage": {
      "type": "decimal"
    },
    "minRawScore": {
      "type": "decimal"
    },
    "maxRawScore": {
      "type": "decimal"
    },
    "level": {
      "type": "enumeration",
      "enum": ["PRE_A1", "A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "placementBandCode": {
      "type": "string"
    },
    "placementLabel": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive"],
      "required": true,
      "default": "active"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "assessmentPlacementRules",
      "required": true
    }
  }
}