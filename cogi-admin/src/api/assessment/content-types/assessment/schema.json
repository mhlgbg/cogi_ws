{
  "kind": "collectionType",
  "collectionName": "assessments",
  "info": {
    "singularName": "assessment",
    "pluralName": "assessments",
    "displayName": "Assessment",
    "description": "Tenant-scoped reusable assessment definition independent from a specific published version."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "assessmentType": {
      "type": "enumeration",
      "enum": [
        "placement",
        "diagnostic",
        "practice",
        "quiz",
        "exam",
        "other"
      ],
      "required": true,
      "default": "placement"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "required": true,
      "default": "draft"
    },
    "subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subject.subject",
      "inversedBy": "assessments"
    },
    "versions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::assessment-version.assessment-version",
      "mappedBy": "assessment"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "assessments",
      "required": true
    }
  }
}
