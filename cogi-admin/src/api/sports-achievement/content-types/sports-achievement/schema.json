{
  "kind": "collectionType",
  "collectionName": "sports_achievements",
  "info": {
    "singularName": "sports-achievement",
    "pluralName": "sports-achievements",
    "displayName": "Sports Achievement",
    "description": "Tenant-scoped recognized sports achievements that have already been verified or officially recorded."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "sportsAchievements",
      "required": true
    },
    "sportsProfile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sports-profile.sports-profile",
      "required": true
    },
    "club": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sports-club.sports-club"
    },
    "achievementType": {
      "type": "enumeration",
      "enum": [
        "personal_best",
        "race_result",
        "champion",
        "podium",
        "finisher",
        "distance_milestone",
        "streak",
        "club_award",
        "system_award",
        "other"
      ],
      "required": true,
      "default": "other",
      "index": true
    },
    "sportType": {
      "type": "enumeration",
      "enum": [
        "running",
        "cycling",
        "badminton",
        "football",
        "swimming",
        "multisport",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "index": true
    },
    "eventCode": {
      "type": "string",
      "maxLength": 120,
      "index": true
    },
    "raceType": {
      "type": "enumeration",
      "enum": [
        "road",
        "trail",
        "track",
        "virtual",
        "other"
      ]
    },
    "bib": {
      "type": "string",
      "maxLength": 120,
      "index": true
    },
    "distancePending": {
      "type": "boolean",
      "default": false,
      "index": true
    },
    "description": {
      "type": "text"
    },
    "achievedAt": {
      "type": "datetime",
      "index": true
    },
    "resultValue": {
      "type": "decimal"
    },
    "distanceKm": {
      "type": "decimal"
    },
    "durationSeconds": {
      "type": "integer",
      "min": 1
    },
    "resultUnit": {
      "type": "string",
      "maxLength": 50
    },
    "resultText": {
      "type": "string",
      "maxLength": 255
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "club",
        "event",
        "manual",
        "system",
        "strava",
        "import",
        "other"
      ],
      "required": true,
      "default": "manual",
      "index": true
    },
    "sourceReference": {
      "type": "string",
      "maxLength": 255
    },
    "shareTemplate": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sports-achievement-template.sports-achievement-template"
    },
    "shareTemplateSource": {
      "type": "enumeration",
      "enum": [
        "explicit",
        "auto",
        "none"
      ],
      "default": "none",
      "index": true
    },
    "evidence": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "note": {
      "type": "text"
    },
    "verifiedAt": {
      "type": "datetime",
      "index": true
    },
    "verifiedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "revokedAt": {
      "type": "datetime",
      "index": true
    },
    "revokedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "revokeReason": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "revoked"
      ],
      "required": true,
      "default": "active",
      "index": true
    }
  }
}
