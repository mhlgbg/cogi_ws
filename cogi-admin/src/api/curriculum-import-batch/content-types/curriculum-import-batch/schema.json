{
  "kind": "collectionType",
  "collectionName": "curriculum_import_batches",
  "info": {
    "singularName": "curriculum-import-batch",
    "pluralName": "curriculum-import-batches",
    "displayName": "Curriculum Import Batch",
    "description": "Audit history for source-import batches."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "batchCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "sourceDocument": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curriculum-source-document.curriculum-source-document",
      "required": true
    },
    "packageCode": {
      "type": "string"
    },
    "fileType": {
      "type": "string"
    },
    "fileHash": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "preview",
        "confirmed",
        "completed",
        "failed"
      ],
      "default": "preview",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "executedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "startedAt": {
      "type": "datetime"
    },
    "completedAt": {
      "type": "datetime"
    }
  }
}
