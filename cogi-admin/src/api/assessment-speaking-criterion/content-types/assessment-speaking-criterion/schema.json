{
  "kind": "collectionType",
  "collectionName": "assessment_speaking_criteria",
  "info": {
    "singularName": "assessment-speaking-criterion",
    "pluralName": "assessment-speaking-criteria",
    "displayName": "Assessment Speaking Criterion",
    "description": "Tenant-scoped speaking review criterion configuration for one assessment version."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "assessmentVersion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::assessment-version.assessment-version",
      "required": true
    },
    "code": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "guidance": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "maxScore": {
      "type": "decimal",
      "required": true
    },
    "weight": {
      "type": "decimal"
    },
    "required": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive"],
      "required": true,
      "default": "active"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "assessmentSpeakingCriteria",
      "required": true
    }
  }
}